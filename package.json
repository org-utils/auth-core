{
  "name": "auth-core-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",

    "test": "vitest",

    "typecheck": "tsc -b",

    "lint": "eslint .",

    "clean": "git clean -xdf",

    "changeset": "changeset",

    "version": "changeset version",

    "release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^22.9.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
