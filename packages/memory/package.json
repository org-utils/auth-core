{
  "name": "@auth-core/memory",
  "version": "0.0.6",
  "description": "In-memory RevocationStore and SessionStore adapters (single-process / testing)",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/org-utils/auth-core.git",
    "directory": "packages/memory"
  },
  "homepage": "https://github.com/org-utils/auth-core#readme",
  "bugs": {
    "url": "https://github.com/org-utils/auth-core/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "auth",
    "session-store",
    "revocation",
    "in-memory"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@auth-core/shared": "^0.0.6"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}
