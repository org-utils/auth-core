{
  "name": "@auth-core/jwt",
  "version": "0.0.8",
  "description": "Generic JWT signing/verification (jose-based) supporting arbitrary token types and algorithms",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "author": "Anwar kamal <anwarkamal1434@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/org-utils/auth-core.git",
    "directory": "packages/jwt"
  },
  "homepage": "https://github.com/org-utils/auth-core#readme",
  "bugs": {
    "url": "https://github.com/org-utils/auth-core/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "auth",
    "jwt",
    "jose",
    "jws",
    "token"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@auth-core/shared": "^0.0.7",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}
