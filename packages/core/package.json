{
  "name": "@auth-core/core",
  "version": "0.0.3",
  "description": "Framework-agnostic authentication core: password hashing, JWTs, refresh rotation, revocation, pluggable storage",
  "main": "./dist/index.mjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@auth-core/shared": "^0.0.3",
    "@auth-core/jwt": "^0.0.3",
    "@auth-core/hashing": "^0.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "license": "MIT",
  "author": "Anwar kamal <anwarkamal1434@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/org-utils/auth-core.git",
    "directory": "packages/auth-core"
  },
  "homepage": "https://github.com/org-utils/auth-core#readme",
  "bugs": {
    "url": "https://github.com/org-utils/auth-core/issues"
  },
  "keywords": [
    "auth",
    "authentication",
    "jwt",
    "argon2",
    "refresh-token",
    "session",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
