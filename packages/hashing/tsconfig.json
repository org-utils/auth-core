{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "emitDeclarationOnly": true,
    "types": ["node"]
  },
  "include": ["src"],
  "references": [
    {
      "path": "../shared"
    }
  ],
  "exclude": [
      "**/*.test.ts",
      "**/*.spec.ts",
      "**/__tests__/**",
      "dist",
      "node_modules"
    ]
}
